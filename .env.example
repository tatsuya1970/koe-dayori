# 声だより の設定（見本）。本物は同じ場所の .env に書く。.env はGitに入れない。
ANTHROPIC_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_ID=

# ---- 以下は任意（書かなければ既定値） ----
# 試しのとき 1：LINE に送らず、ログに出すだけ
KOE_DRY_RUN=0
# 親の呼び名（LINE の文面に使う）
KOE_PARENT_NAME=お母さん
# LINE の表示名 → 読み上げで使う呼び名（カンマ区切り）
KOE_SENDER_NAMES=
# mention：公式アカウントにメンションした文だけ読む / all：グループの文を全部読む（U24）
KOE_REPLY_FILTER=mention
# 「聞きました」「まだ聞いていません」を送るか（LINE の通数を減らすなら 0。U28）
KOE_NOTIFY_PLAYED=1
KOE_NOTIFY_UNPLAYED=1
# フックスイッチ：受話器を取ったときに「押された」になる配線なら 1（押しボタン版は 1）
KOE_HOOK_PRESSED_IS_OFF_HOOK=1
# 音のデバイス（aplay -l / arecord -l で調べる。例 plughw:2,0）
KOE_HANDSET_PLAY_DEVICE=default
KOE_HANDSET_REC_DEVICE=default
KOE_SPEAKER_DEVICE=default
# 人感センサーをつないでいないときは 0（動きがない知らせを出さない）
KOE_WATCH_ENABLED=1
